u003d\"f260b4fc-1968-42a6-a407-023bbfe2bcec\" variableName\u003d\"genres\"\u003e\u003c/set-variable\u003e\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger\" doc:id\u003d\"be21ab9a-a220-43de-b4ec-0c554896c269\"\u003e\u003c/logger\u003e\n\u003cset-variable value\u003d\"#[[]]\" doc:name\u003d\"minimizedTracks[]\" doc:id\u003d\"7e951c03-7490-49a0-9b6c-73ae1074a2c0\" variableName\u003d\"minimizedTracks\"\u003e\u003c/set-variable\u003e\n\u003cforeach doc:name\u003d\"For Each genres\" doc:id\u003d\"553ceb9a-a1e8-4aed-af1a-84a1a9e8a0fc\" collection\u003d\"#[vars.genres]\"\u003e\n\u003cset-variable value\u003d\"#[vars.genres[vars.counter-1]]\" doc:name\u003d\"[genre]\" doc:id\u003d\"a5ae5a4c-1028-41f0-b2d8-5e3bead8391d\" variableName\u003d\"genre\"\u003e\u003c/set-variable\u003e\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"to Lastfm (tags.topTracks)\" doc:id\u003d\"5e5501c7-bf54-4ebb-bf29-664188be9b91\" config-ref\u003d\"LastfmRequestConfig\" path\u003d\"/\"\u003e\n\u003chttp:query-params\u003e\u003c![CDATA[\n#[output application/java\n---\n{\n\t\"method\" : \"tag.gettoptracks\",\n\t\"tag\" : vars.genre,\n\t\"page\": \"1\",\n\t\"limit\": \"8\",\n\t\"format\": \"json\",\n\t\"api_key\": \"${lastfm.apiKey}\"\n}]\n]]\u003e\u003c/http:query-params\u003e\n\u003c/http:request\u003e\n\u003cset-variable value\u003d\"#[output application/json\n---\nvars.minimizedTracks ++ [payload]]\" doc:name\u003d\"minimizedTracks ++ payload\" doc:id\u003d\"159036e9-62b3-45b8-b355-462a64ddbd59\" variableName\u003d\"minimizedTracks\"\u003e\u003c/set-variable\u003e\n\u003c/foreach\u003e\n\u003cset-variable value\u003d\"#[output application/json\n---\nflatten(vars.minimizedTracks.tracks.track map () -\u003e $.mbid)]\" doc:name\u003d\"[mbids]\" doc:id\u003d\"4704dd8f-12e6-4bc2-88e2-fcd14041bfd8\" variableName\u003d\"mbids\"\u003e\u003c/set-variable\u003e\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger1\" doc:id\u003d\"076db9fa-57dc-4ef0-b181-0bee8bdd59aa\"\u003e\u003c/logger\u003e\n\u003cset-variable value\u003d\"#[[]]\" doc:name\u003d\"[tracks]\" doc:id\u003d\"025883c4-ac99-4af4-876e-14035897e976\" variableName\u003d\"tracks\"\u003e\u003c/set-variable\u003e\n\u003cforeach doc:name\u003d\"For Each mbids\" doc:id\u003d\"2ca20d26-8880-404b-be2c-f27b3ab18a94\" collection\u003d\"#[vars.mbids]\"\u003e\n\u003cset-variable value\u003d\"#[%dw 2.0\noutput application/json\n---\nvars.mbids[vars.counter-1]]\" doc:name\u003d\"[mbid]\" doc:id\u003d\"60ac9920-d03f-42b7-9a9d-65122d51faf1\" variableName\u003d\"mbid\"\u003e\u003c/set-variable\u003e\n\u003chttp:request method\u003d\"GET\" doc:name\u003d\"to Lastfm (track.getInfo)\" doc:id\u003d\"1d952de8-223b-4f3a-82ef-cc3d2240af14\" config-ref\u003d\"LastfmRequestConfig\" path\u003d\"/\"\u003e\n\u003chttp:query-params\u003e\u003c![CDATA[\n#[output application/java\n---\n{\n\t\"method\" : \"track.getInfo\",\n\t\"mbid\" : vars.mbid,\n\t\"format\": \"json\",\n\t\"api_key\": \"${lastfm.apiKey}\"\n}]\n]]\u003e\u003c/http:query-params\u003e\n\u003c/http:request\u003e\n\u003cset-variable value\u003d\"#[output application/json\n---\nvars.tracks ++ [payload]]\" doc:name\u003d\"tracks ++ payload\" doc:id\u003d\"04ef1a0d-10e4-4d15-b175-9353a770afb3\" variableName\u003d\"tracks\"\u003e\u003c/set-variable\u003e\n\u003c/foreach\u003e\n\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"7a390430-707d-4efd-ba2f-4afc02f0dc11\"\u003e\n\u003cee:message\u003e\n\u003cee:set-payload\u003e\u003c![CDATA[\n%dw 2.0\noutput application/json\n\nfun extractDate(publishedString) \u003d \n    if (publishedString contains \",\")\n        publishedString splitBy \",\" map trim(\"_\") then \n        ((publishedString splitBy \" \")[0] as String) ++ \"-\" ++ \n        ((monthToNumber(((publishedString splitBy \" \")[1] as String))) as String) ++ \"-\" ++ \n        ((publishedString splitBy \" \")[2] as String)\n    else\n        \"2000-01-01\" // Default date if format doesn\u0027t match\n\nfun monthToNumber(month) \u003d\n    {\n        \"Jan\": \"01\",\n        \"Feb\": \"02\",\n        \"Mar\": \"03\",\n        \"Apr\": \"04\",\n        \"May\": \"05\",\n        \"Jun\": \"06\",\n        \"Jul\": \"07\",\n        \"Aug\": \"08\",\n        \"Sep\": \"09\",\n        \"Oct\": \"10\",\n        \"Nov\": \"11\",\n        \"Dec\": \"12\"\n    }[month] default \"01\"\n\nfun extractLargeImage(images) \u003d\n    (images filter ($.size \u003d\u003d \"large\"))[0][\"#text\"] default \"\"\n\nfun extractTags(tagArray) \u003d\n    tagArray map $.name\n\n---\n(vars.tracks filter (item) -\u003e !item.error?) map (item) -\u003e {\n    mbid: item.track.mbid,\n    name: item.track.name,\n    artist: {\n        mbid: item.track.artist.mbid,\n        name: item.track.artist.name,\n        url: item.track.artist.url\n    },\n    url: item.track.url,\n    imageUrl: extractLargeImage(item.track.album.image),\n    date: extractDate(item.track.wiki.published),\n    listeners: item.track.listeners as Number,\n    playcount: item.track.playcount as Number,\n    summary: item.track.wiki.summary,\n    tags: extractTags(item.track.toptags.tag)\n}\n]]\u003e\u003c/ee:set-payload\u003e\n\u003c/ee:message\u003e\n\u003c/ee:transform\u003e\n\u003clogger level\u003d\"INFO\" doc:name\u003d\"Logger\" doc:id\u003d\"019e1027-ed5c-4186-8a3b-7da41f3017d6\" message\u003d\"#[vars.tracks]\"\u003e\u003c/logger\u003e\n\u003c/sub-flow\u003e","startColumn":2,"startLine":8},"parameters":[{"unresolvedValue":"getTracks","metadata":{"docAttributes":{"id":"24585d3e-793f-4a2d-afd3-333ad20cdf4b"},"endColumn":13,"endLine":101,"fileName":"implementations/tracks.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":2},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":13},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":8},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":8},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":101},"CLOSING_T