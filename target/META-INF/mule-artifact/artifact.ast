ule","namespaceUri":"http://www.mulesoft.org/schema/mule/core"},"type":{"name":"CHAIN"}},"fileName":"implementations/tracks.xml","line":8,"column":2},{"partPath":"processors"},{"partPath":"8","partIdentifier":{"identifier":{"name":"transform","namespace":"ee","namespaceUri":"http://www.mulesoft.org/schema/mule/ee/core"},"type":{"name":"OPERATION"}},"fileName":"implementations/tracks.xml","line":45,"column":3}],"location":"getTracks/processors/8"},"metadata":{"docAttributes":{"name":"Transform Message","id":"7a390430-707d-4efd-ba2f-4afc02f0dc11"},"endColumn":18,"endLine":99,"fileName":"implementations/tracks.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":18},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":45},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":45},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":99},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":3},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":93},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":99},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"}},"sourceCode":"\u003cee:transform doc:name\u003d\"Transform Message\" doc:id\u003d\"7a390430-707d-4efd-ba2f-4afc02f0dc11\"\u003e\n\u003cee:message\u003e\n\u003cee:set-payload\u003e\u003c![CDATA[\n%dw 2.0\noutput application/json\n\nfun extractDate(publishedString) \u003d \n    if (publishedString contains \",\")\n        publishedString splitBy \",\" map trim(\"_\") then \n        ((publishedString splitBy \" \")[0] as String) ++ \"-\" ++ \n        ((monthToNumber(((publishedString splitBy \" \")[1] as String))) as String) ++ \"-\" ++ \n        ((publishedString splitBy \" \")[2] as String)\n    else\n        \"2000-01-01\" // Default date if format doesn\u0027t match\n\nfun monthToNumber(month) \u003d\n    {\n        \"Jan\": \"01\",\n        \"Feb\": \"02\",\n        \"Mar\": \"03\",\n        \"Apr\": \"04\",\n        \"May\": \"05\",\n        \"Jun\": \"06\",\n        \"Jul\": \"07\",\n        \"Aug\": \"08\",\n        \"Sep\": \"09\",\n        \"Oct\": \"10\",\n        \"Nov\": \"11\",\n        \"Dec\": \"12\"\n    }[month] default \"01\"\n\nfun extractLargeImage(images) \u003d\n    (images filter ($.size \u003d\u003d \"large\"))[0][\"#text\"] default \"\"\n\nfun extractTags(tagArray) \u003d\n    tagArray map $.name\n\n---\n(vars.tracks filter (item) -\u003e !item.error?) map (item) -\u003e {\n    mbid: item.track.mbid,\n    name: item.track.name,\n    artist: {\n        mbid: item.track.artist.mbid,\n        name: item.track.artist.name,\n        url: item.track.artist.url\n    },\n    url: item.track.url,\n    imageUrl: extractLargeImage(item.track.album.image),\n    date: extractDate(item.track.wiki.published),\n    listeners: item.track.listeners as Number,\n    playcount: item.track.playcount as Number,\n    summary: item.track.wiki.summary,\n    tags: extractTags(item.track.toptags.tag)\n}\n]]\u003e\u003c/ee:set-payload\u003e\n\u003c/ee:message\u003e\n\u003c/ee:transform\u003e","startColumn":3,"startLine":45},"parameters":[{"metadata":{"docAttributes":{},"endColumn":22,"endLine":97,"fileName":"implementations/tracks.xml","importLocationChain":[],"parserAttributes":{"OPENING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"CLOSING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":22},"OPENING_TAG_END_LINE":{"type":"java.lang.Integer","value":47},"OPENING_TAG_START_LINE":{"type":"java.lang.Integer","value":47},"CLOSING_TAG_START_LINE":{"type":"java.lang.Integer","value":97},"CLOSING_TAG_START_COLUMN":{"type":"java.lang.Integer","value":5},"OPENING_TAG_END_COLUMN":{"type":"java.lang.Integer","value":22},"CLOSING_TAG_END_LINE":{"type":"java.lang.Integer","value":97},"DECLARED_PREFIX":{"type":"java.lang.String","value":"ee"},"IS_CDATA":{"type":"java.lang.Boolean","value":true}},"sourceCode":"\